{
  "name": "agent-studio-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/clean-build.cjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:migrate": "node-pg-migrate up -m migrations --no-verbose",
    "dev:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:api": "node --watch dist/main.js",
    "dev:worker": "node --watch dist/worker.js",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "admin:bootstrap": "node dist/admin/bootstrap.js",
    "documents:reindex": "node scripts/reindex-all-documents.mjs",
    "eval:agent": "node scripts/evaluate-agent.mjs",
    "smoke:formats": "node scripts/smoke-document-formats.mjs",
    "verify:agent:live": "npm run build && node scripts/verify-agent-live.cjs",
    "verify:deep-agent:live": "npm run build && node scripts/verify-deep-agent-live.cjs",
    "verify:model-sdk:live": "npm run build && node scripts/verify-model-sdk-live.cjs",
    "verify:files:live": "npm run build && node scripts/verify-agent-live.cjs --files-only",
    "verify:phoenix": "npm run build && node scripts/verify-phoenix.cjs"
  },
  "dependencies": {
    "@agent-studio/output-contract": "file:../packages/output-contract",
    "@arizeai/openinference-core": "2.8.0",
    "@arizeai/openinference-instrumentation-langchain": "4.1.4",
    "@arizeai/openinference-semantic-conventions": "2.14.0",
    "@arizeai/phoenix-otel": "2.2.0",
    "@inquirer/prompts": "^8.7.2",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@langchain/openai": "1.6.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "ajv": "8.20.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "deepagents": "1.14.2",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "3.3.1",
    "langchain": "1.5.16",
    "mammoth": "^1.12.3",
    "markdown-it": "^15.0.2",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "jszip": "^3.10.2",
    "protobufjs": "8.8.1",
    "typescript": "~5.9.3"
  }
}
