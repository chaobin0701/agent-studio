# Local settings only; never commit the generated .env.
POSTGRES_DB=agent_studio
POSTGRES_USER=agentstudio
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5437
DATABASE_URL=postgres://agentstudio:replace-with-a-random-password@127.0.0.1:5437/agent_studio
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=agent-studio
JWT_AUDIENCE=agent-studio-admin
# Admin token lifetime in seconds (maximum: 24 hours).
JWT_EXPIRES_IN_SECONDS=86400
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
PORT=3020
ADMIN_PORT=8085
UPLOAD_ROOT=../.data/uploads
TRUST_PROXY=0
ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
# Configure suppliers and model plans in the admin; no provider keys are bundled.
LLM_API_KEY=
EMBEDDING_API_KEY=
# LangSmith export is metadata-only unless CONTENT_ENABLED is explicitly true.
# Content mode sends prompts, messages, model outputs, and tool inputs/results after credential redaction.
# Never use ambient LANGSMITH_TRACING.
AGENT_STUDIO_LANGSMITH_ENABLED=false
AGENT_STUDIO_LANGSMITH_CONTENT_ENABLED=false
AGENT_STUDIO_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
AGENT_STUDIO_LANGSMITH_API_KEY=
AGENT_STUDIO_LANGSMITH_PROJECT=agent-studio-production
# Optional LangSmith tenant/workspace UUID and project UUID for direct run links.
# These are not Agent Studio workspace IDs. Otherwise links resolve using a read-capable key.
AGENT_STUDIO_LANGSMITH_WORKSPACE_ID=
AGENT_STUDIO_LANGSMITH_PROJECT_ID=
# For agent-based LangSmith workspaces, clear PROJECT and set BOTH of these instead.
AGENT_STUDIO_LANGSMITH_AGENT_ID=
AGENT_STUDIO_LANGSMITH_ENVIRONMENT=
# Required for self-hosted destinations; official cloud UI is inferred by region.
AGENT_STUDIO_LANGSMITH_WEB_URL=
AGENT_STUDIO_LANGSMITH_SAMPLE_RATE=1
AGENT_STUDIO_LANGSMITH_TIMEOUT_MS=2000
AGENT_STUDIO_LANGSMITH_QUEUE_LIMIT=1000
