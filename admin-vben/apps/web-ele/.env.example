# Public frontend settings only. Never put credentials in VITE_* variables.
# Optional: copy to .env. App code already defaults to /api/admin without it.
VITE_APP_TITLE=Agent Studio
VITE_APP_NAMESPACE=agent-studio-admin
VITE_GLOB_API_URL=/api/admin
VITE_BASE=/
VITE_ROUTER_HISTORY=hash
VITE_PORT=8085
VITE_DEVTOOLS=false
VITE_NITRO_MOCK=false
VITE_PWA=false
VITE_ARCHIVER=false
VITE_INJECT_APP_LOADING=true
